# URL de la aplicacion principal (Plataforma React en /client)
# En desarrollo apunta al servidor Vite del cliente.
# En produccion, reemplazar con la URL real de la app.
VITE_APP_URL=http://localhost:5173

# URL del backend de la API al que la landing POSTea el formulario de contacto.
# En desarrollo apunta al server Express local. En producción, la URL real de la API.
VITE_API_URL=http://localhost:3001
