NODE_ENV=development
PORT=3001
MONGODB_URI=
JWT_SECRET=

# ── Autenticación / tokens ────────────────────────────────────────────────────
# Vida del access JWT (stateless, vida corta). Formato: <número><unidad> (s/m/h/d).
ACCESS_TOKEN_TTL=15m
# Vida del refresh token (almacenado en BD, cookie httpOnly). Formato: <número><unidad>.
REFRESH_TOKEN_TTL=14d
# DEPRECADO: JWT_EXPIRES_IN ya no controla la vida del access token.
# Se reemplaza por ACCESS_TOKEN_TTL. Puede eliminarse en la próxima limpieza de config.
# JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173
DEMO_MODE=false
PAYMENT_PROVIDER=mock

# Carga y servido de bundles de juego
# Origen del cliente permitido a embeber los bundles (CSP frame-ancestors del servido dedicado)
CLIENT_ORIGIN=http://localhost:5173
# Servido de bundles: listener dedicado en origen separado de la API (aislamiento de seguridad).
# En producción, GAME_PUBLIC_ORIGIN apunta a un subdominio (ej. https://juegos.midominio.cl)
# servido por reverse-proxy hacia GAME_PUBLIC_PORT.
GAME_PUBLIC_PORT=3002
GAME_PUBLIC_ORIGIN=http://localhost:3002
# Directorio en disco donde se descomprimen y almacenan los bundles (no versionar)
GAME_STORAGE_DIR=
# Límites de subida de bundle (opcionales; defaults en código)
BUNDLE_MAX_ZIP_BYTES=52428800
BUNDLE_MAX_FILES=2000
BUNDLE_MAX_FILE_BYTES=52428800
BUNDLE_MAX_TOTAL_BYTES=209715200

# Contacto de la landing (envío transaccional vía Resend)
# RESEND_API_KEY es SECRETO: no versionar el valor real. Obtener en https://resend.com
RESEND_API_KEY=
# Remitente verificado en Resend, sobre un dominio verificado en la cuenta de Resend
RESEND_FROM=Didactifonis <contacto@midominio.cl>
# Buzón de destino de los mensajes del formulario de contacto
CONTACT_TO=soporte@midominio.cl
