NODE_ENV=development
PORT=3001
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
DEMO_MODE=false
PAYMENT_PROVIDER=mock

# Carga y servido de bundles de juego
# Origen del cliente permitido a embeber los bundles (CSP frame-ancestors del servido dedicado)
CLIENT_ORIGIN=http://localhost:5173
# Servido de bundles: listener dedicado en origen separado de la API (aislamiento de seguridad).
# En producción, GAME_PUBLIC_ORIGIN apunta a un subdominio (ej. https://juegos.midominio.cl)
# servido por reverse-proxy hacia GAME_PUBLIC_PORT.
GAME_PUBLIC_PORT=3002
GAME_PUBLIC_ORIGIN=http://localhost:3002
# Directorio en disco donde se descomprimen y almacenan los bundles (no versionar)
GAME_STORAGE_DIR=
# Límites de subida de bundle (opcionales; defaults en código)
BUNDLE_MAX_ZIP_BYTES=52428800
BUNDLE_MAX_FILES=2000
BUNDLE_MAX_FILE_BYTES=52428800
BUNDLE_MAX_TOTAL_BYTES=209715200
